# Copy this file to .env and replace every /path/to value.
# Use absolute Linux paths. On Windows, run through WSL2 and use /mnt/c/... paths.
SIM1_ROOT=/path/to/shirt-demo-assets/SIM1
EPISODE_ROOT=/path/to/shirt-demo-assets/episode_000000
GENESIS_ROOT=/path/to/genesis-world
GENESIS_ENV=/path/to/genesis-ipc-env
SIM1_PYTHON=/path/to/sim1-python

# Optional overrides:
# GENESIS_GPU=0
# OUTPUT_ROOT=/path/to/output
